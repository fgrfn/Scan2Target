<?xml version="1.0"?>
<Container version="2">
  <Name>Scan2Target</Name>
  <Repository>ghcr.io/fgrfn/scan2target:latest</Repository>
  <Registry>https://github.com/fgrfn/Scan2Target/pkgs/container/scan2target</Registry>
  <Network>host</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/fgrfn/Scan2Target/issues</Support>
  <Project>https://github.com/fgrfn/Scan2Target</Project>
  <Overview>Web-based network scanner workflow with persistent delivery targets and retries.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <Icon>https://raw.githubusercontent.com/fgrfn/Scan2Target/main/app/web/public/icon-192.png</Icon>
  <ExtraParams>--security-opt=no-new-privileges:true</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>0</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>Host networking is recommended for mDNS/AirScan discovery. USB scanners may require /dev/bus/usb and privileged mode depending on the host.</Requires>
  <Config Name="Persistent data" Target="/data" Default="/mnt/user/appdata/scan2target" Mode="rw" Description="Database, encryption keys, retained scans and backups" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Encryption secret" Target="SCAN2TARGET_SECRET_KEY" Default="" Mode="" Description="Generate with: openssl rand -base64 48" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Require authentication" Target="SCAN2TARGET_REQUIRE_AUTH" Default="true" Mode="" Description="Require login for the API and Web UI" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Home Assistant API key" Target="SCAN2TARGET_HA_API_KEY" Default="" Mode="" Description="Optional dedicated Home Assistant key" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Maximum delivery attempts" Target="SCAN2TARGET_DELIVERY_MAX_RETRIES" Default="5" Mode="" Description="Total persistent delivery attempts" Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Retry base delay" Target="SCAN2TARGET_RETRY_BASE_DELAY" Default="30" Mode="" Description="Initial retry delay in seconds; later retries use exponential backoff" Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="Allow private webhooks" Target="SCAN2TARGET_ALLOW_PRIVATE_WEBHOOKS" Default="false" Mode="" Description="Allow callbacks to private/local network addresses" Type="Variable" Display="advanced" Required="true" Mask="false"/>
</Container>
