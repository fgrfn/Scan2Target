# Scan2Target Docker Environment Configuration
# Copy to .env and generate unique secrets before starting.

# Credential encryption key (required for Docker deployments)
# Generate with: openssl rand -base64 48
SCAN2TARGET_SECRET_KEY=

# Optional separate JWT signing secret. When omitted, SECRET_KEY is reused;
# native installs without either variable create /data/auth/jwt.secret (0600).
# SCAN2TARGET_JWT_SECRET=

# Authentication is enabled by default. A fresh installation asks you to create
# the first administrator in the Web UI; there is no default password.
SCAN2TARGET_REQUIRE_AUTH=true

# Optional API key dedicated to Home Assistant REST endpoints.
# SCAN2TARGET_HA_API_KEY=

# Browser CORS is disabled by default because the Web UI is same-origin.
# Add comma-separated external UI origins only when needed.
# SCAN2TARGET_CORS_ORIGINS=https://scan.example.com

# Per-scan callback URLs cannot resolve to private/local IPs by default.
# Enable only when trusted clients need LAN webhooks.
SCAN2TARGET_ALLOW_PRIVATE_WEBHOOKS=false

# Request and manual multi-page limits
SCAN2TARGET_MAX_REQUEST_SIZE_MB=100
SCAN2TARGET_MAX_BATCH_PAGE_MB=20
SCAN2TARGET_MAX_BATCH_PAGES=100

# Persistent application paths
SCAN2TARGET_DATA_DIR=/data
SCAN2TARGET_DATABASE_PATH=/data/db/scan2target.db

# Scanner reachability check interval in seconds
# SCAN2TARGET_SCANNER_CHECK_INTERVAL=30
# SCAN2TARGET_HEALTH_CHECK_INTERVAL=60
